# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL aplikasi (WAJIB — dipakai jurnal server-side & OAuth TikTok callback)
# Dev: http://localhost:3000 · Production: https://kjhomedecor.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# TikTok Shop (webhook HMAC — WAJIB di-set, kalau kosong verifikasi di-skip)
TIKTOK_APP_SECRET=

# Shopee Seller (Open Platform — @congminh1254/shopee-sdk, region GLOBAL = partner.shopeemobile.com)
# Fallback webhook HMAC bila DB shopee_shop_settings belum ada (opsional, biasanya dari DB)
SHOPEE_PARTNER_KEY=
